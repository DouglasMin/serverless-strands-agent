{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "serverlessstrands",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "serverlessstrands"
  },
  "runtimes": [
    {
      "name": "MainAgent",
      "build": "Container",
      "entrypoint": "main.py",
      "codeLocation": "app/MainAgent/",
      "runtimeVersion": "PYTHON_3_14",
      "envVars": [
        {
          "name": "DISABLE_ADOT_OBSERVABILITY",
          "value": "true"
        },
        {
          "name": "ENVIRONMENT",
          "value": "prod"
        },
        {
          "name": "LANGFUSE_SECRET_ID",
          "value": "serverlessstrands/langfuse"
        },
        {
          "name": "OTEL_SERVICE_NAME",
          "value": "serverlessstrands-mainagent"
        },
        {
          "name": "MEMORY_ID",
          "value": "serverlessstrands_ChatMemory-4Q3NbO5016"
        },
        {
          "name": "OAUTH_CALLBACK_URL",
          "value": "https://d1rur2clzx2nyl.cloudfront.net/auth/callback"
        },
        {
          "name": "WORKLOAD_NAME",
          "value": "serverlessstrands_MainAgent-4l0O95618E"
        },
        {
          "name": "DEEP_RESEARCH_RUNTIME_ARN",
          "value": "arn:aws:bedrock-agentcore:ap-northeast-2:612529367436:runtime/serverlessstrands_DeepResearchAgent-fNxJzC68TQ"
        }
      ],
      "networkMode": "PUBLIC",
      "protocol": "HTTP"
    },
    {
      "name": "DeepResearchAgent",
      "build": "Container",
      "entrypoint": "main.py",
      "codeLocation": "app/DeepResearchAgent/",
      "runtimeVersion": "PYTHON_3_14",
      "envVars": [
        {
          "name": "DISABLE_ADOT_OBSERVABILITY",
          "value": "true"
        },
        {
          "name": "ENVIRONMENT",
          "value": "prod"
        },
        {
          "name": "LANGFUSE_SECRET_ID",
          "value": "serverlessstrands/langfuse"
        },
        {
          "name": "OTEL_SERVICE_NAME",
          "value": "serverlessstrands-deepresearchagent"
        },
        {
          "name": "WORKLOAD_NAME",
          "value": "serverlessstrands_DeepResearchAgent"
        }
      ],
      "networkMode": "PUBLIC",
      "protocol": "HTTP"
    }
  ],
  "memories": [
    {
      "name": "ChatMemory",
      "eventExpiryDuration": 30,
      "strategies": [
        {
          "type": "SUMMARIZATION",
          "namespaceTemplates": [
            "/summaries/{actorId}/{sessionId}"
          ]
        },
        {
          "type": "USER_PREFERENCE",
          "namespaceTemplates": [
            "/users/{actorId}/preferences"
          ]
        },
        {
          "type": "SEMANTIC",
          "namespaceTemplates": [
            "/users/{actorId}/facts"
          ]
        }
      ]
    }
  ],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [
    {
      "name": "ToolGateway",
      "description": "IAM-authenticated gateway for the tool Lambdas",
      "targets": [
        {
          "name": "yahoo-finance",
          "targetType": "lambdaFunctionArn",
          "lambdaFunctionArn": {
            "lambdaArn": "arn:aws:lambda:ap-northeast-2:612529367436:function:serverlessstrands-dev-tool-finance",
            "toolSchemaFile": "../tools/finance/tool-schema.json"
          }
        },
        {
          "name": "tavily-lamdba-tool",
          "targetType": "lambdaFunctionArn",
          "lambdaFunctionArn": {
            "lambdaArn": "arn:aws:lambda:ap-northeast-2:612529367436:function:serverlessstrands-dev-tool-tavily",
            "toolSchemaFile": "../tools/tavily/tool-schema.json"
          }
        },
        {
          "name": "google-maps",
          "targetType": "lambdaFunctionArn",
          "lambdaFunctionArn": {
            "lambdaArn": "arn:aws:lambda:ap-northeast-2:612529367436:function:serverlessstrands-dev-tool-google-maps",
            "toolSchemaFile": "../tools/google-maps/tool-schema.json"
          }
        }
      ],
      "authorizerType": "AWS_IAM",
      "enableSemanticSearch": true,
      "exceptionLevel": "NONE"
    }
  ],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "httpGateways": [],
  "datasets": []
}